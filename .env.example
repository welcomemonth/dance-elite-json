# 复制为 .env（已被 .gitignore 忽略）用于本地开发；生产环境由容器/编排注入环境变量。
# 后端启动时会做自检：必需项缺失直接 fail-fast，并在错误日志中列出缺失项。
#
# 生成随机密钥：openssl rand -hex 32

# ---- 服务（非敏感，均有代码默认值）----
PORT=8080
DEBUG=true
DB_PATH=data/dance-elite.db
# 上传文件物理目录（证件照/音频/头像）；生产须挂 volume，赛后媒体清理保留 avatars/
UPLOAD_DIR=uploads
PAY_MOCK=true
JWT_EXPIRE_SECONDS=7200

# ---- 始终必需 ----
JWT_SECRET=
ID_CARD_HMAC_KEY=
WECHAT_APPID=
WECHAT_SECRET=
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=

# ---- 真实支付（PAY_MOCK=false）时必需 ----
WECHAT_MCHID=
# APIv3 密钥：32 字节，回调报文 AES-256-GCM 解密用
WECHAT_PAY_KEY=
# 商户 API 证书序列号（请求签名）
WECHAT_MCH_SERIAL_NO=
# 微信支付平台证书 PEM（回调验签公钥；证书轮换时更新）
WECHAT_PAY_CERT=
# 商户 API 私钥 PEM（PKCS#8/PKCS#1，可用 \n 单行写法）
WECHAT_PAY_PRIVATE_KEY=
# 支付结果回调地址，指向 POST /api/v1/payments/wechat/notify
WECHAT_PAY_NOTIFY_URL=
