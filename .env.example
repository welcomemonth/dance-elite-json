# 复制为 .env（已被 .gitignore 忽略）用于本地开发；生产环境由容器/编排注入环境变量。
# 后端启动时会做自检：必需项缺失直接 fail-fast，并在错误日志中列出缺失项。
#
# 生成随机密钥：openssl rand -hex 32

# ---- 服务（非敏感，均有代码默认值）----
PORT=8080
DEBUG=true
DB_PATH=data/dance-elite.db
PAY_MOCK=true

# ---- 始终必需 ----
JWT_SECRET=
ID_CARD_HMAC_KEY=
WECHAT_APPID=
WECHAT_SECRET=
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=

# ---- 真实支付（PAY_MOCK=false）时必需 ----
WECHAT_MCHID=
WECHAT_PAY_KEY=
WECHAT_MCH_SERIAL_NO=
WECHAT_PAY_CERT=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_NOTIFY_URL=
